	local function find_active_farm_map()
		local now = os.clock()
		if now < farm_stage_scan_at then
			return farm_stage_name, farm_stage_position
		end
		-- Scanning all of Workspace every few frames caused unnecessary CPU spikes.
		-- Prefer the active Map container and only use a throttled fallback scan.
		farm_stage_scan_at = now + 1.25

		local found = nil
		local function check_name(obj)
			if not obj then return nil end
			local key = farm_stage_normalized[normalize_map_name(obj.Name)]
			return key
		end
		local map_root = workspace:FindFirstChild("Map") or workspace:FindFirstChild("map")
		if map_root then
			found = check_name(map_root)
			if not found then
				for _, obj in ipairs(map_root:GetDescendants()) do
					found = check_name(obj)
					if found then break end
				end
			end
		end
		if not found then
			-- Check top-level models first; only do a full fallback if the game uses a different hierarchy.
			for _, obj in ipairs(workspace:GetChildren()) do
				found = check_name(obj)
				if found then break end
			end
		end
		if not found and not map_root then
			for _, obj in ipairs(workspace:GetDescendants()) do
				found = check_name(obj)
				if found then break end
			end
		end

		local old_name = farm_stage_name
		if found then
			farm_stage_name = found.name
			farm_stage_position = found.position
		else
			farm_stage_name = nil
			farm_stage_position = nil
		end
		if old_name ~= farm_stage_name then
			farm_stage_ready = false
			farm_target = nil
			saw_coins = false
			farm_stage_last_teleport = 0
			farm_stage_last_teleport_position = nil
		end
		return farm_stage_name, farm_stage_position
	end

	local function farm_stage_to_map(position)
		local hrp = farm_hrp()
		if not hrp or not position then return false end
		local now = os.clock()
		local same_position = farm_stage_last_teleport_position
			and (farm_stage_last_teleport_position - position).Magnitude < 1
		if same_position and farm_stage_locked_root == hrp and (hrp.Position - position).Magnitude <= 8 then
			farm_stage_lock(hrp)
			return true
		end
		-- Anchor only while waiting for the round/map to initialize. Noclip + PlatformStand
		-- let gravity pull the character down, causing the old fall/teleport loop.
		if same_position and now - farm_stage_last_teleport < 0.9 then
			farm_stage_lock(hrp)
			return false
		end
		farm_stage_lock(hrp)
		local ok = pcall(function()
			hrp.CFrame = CFrame.new(position)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
			hrp.Anchored = true
		end)
		if ok then
			farm_stage_last_teleport = now
			farm_stage_last_teleport_position = position
		end
		return ok
	end

	local function farm_unknown_map_position(coins)
		if not coins or #coins == 0 then return nil end
		local sx, sy, sz, maxY, count = 0, 0, 0, -math.huge, 0
		for _, coin in ipairs(coins) do
			if coin and coin.Parent and coin:IsA("BasePart") then
				local pos = coin.Position
				sx, sy, sz = sx + pos.X, sy + pos.Y, sz + pos.Z
				maxY = math.max(maxY, pos.Y)
				count = count + 1
			end
		end
		if count == 0 then return nil end
		-- Unknown map: use the live coin cluster as a grounded map locator, not a random spawn.
		return Vector3.new(sx / count, maxY + 24, sz / count)
	end

	local function available_coins()
		local list = {}
		for _, v in ipairs(cs:GetTagged("CoinVisual")) do
			if coin_available(v) then
				list[#list + 1] = v
			end
		end
		return list
	end

	local function stage_before_coins()
		local _, position = find_active_farm_map()
		if not position then return false end
		if #available_coins() > 0 then
			farm_stage_ready = true
			return true
		end
		farm_stage_ready = false
		farm_stage_to_map(position)
		return false
	end

	local function nearest_coin(pos, list)
		local best, bd = nil, math.huge
		for _, v in ipairs(list) do
			local d = (v.Position - pos).Magnitude
			if d < bd then bd = d best = v end
		end
		return best
	end

	set_farm_noclip = function(on)
		local char = lp.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		if on then
			if not char then return end
			if hum then pcall(function() hum.PlatformStand = true end) end
			for _, p in ipairs(char:GetDescendants()) do
				if p:IsA("BasePart") and p.CanCollide then
					if nc_cache[p] == nil then nc_cache[p] = p.CanCollide end
					p.CanCollide = false
				end
			end
		else
			if hum then pcall(function() hum.PlatformStand = false end) end
			for p, v in pairs(nc_cache) do
				if p and p.Parent then pcall(function() p.CanCollide = v end) end
			end
			nc_cache = {}
		end
	end

	local up_params = RaycastParams.new()
	up_params.FilterType = Enum.RaycastFilterType.Exclude
	up_params.IgnoreWater = true

	local function return_to_surface()
		local hrp = farm_hrp()
		if not hrp then return end
		local origin = hrp.Position
		up_params.FilterDescendantsInstances = { lp.Character }
		local res = workspace:Raycast(origin, Vector3.new(0, 400, 0), up_params)
		local y = res and (res.Position.Y + 5) or (down_ref_y and down_ref_y + 5 or nil)
		if not y then return end
		pcall(function()
			hrp.CFrame = CFrame.new(origin.X, y, origin.Z)
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
	end

	local function farm_release()
		farm_stage_unlock()
		if was_down then
			was_down = false
			return_to_surface()
		end
		set_farm_noclip(false)
	end

	local murder_hrp_cache, murder_hrp_t = nil, 0
	local function murderer_hrp()
		local now = os.clock()
		if now - murder_hrp_t < 0.25 then return murder_hrp_cache end
		murder_hrp_t = now
		murder_hrp_cache = nil
		local d = get_round_data()
		if type(d) == "table" then
			local me = d[lp.Name]
			if me and me.Role == "Murderer" then return nil end
			for name, info in pairs(d) do
				if type(info) == "table" and info.Role == "Murderer" and not info.Dead and name ~= lp.Name then
					local pl = players:FindFirstChild(name)
					local char = pl and pl.Character
					local h = char and char:FindFirstChild("HumanoidRootPart")
					local hum = char and char:FindFirstChildOfClass("Humanoid")
					if h and (not hum or hum.Health > 0) then murder_hrp_cache = h end
					break
				end
			end
		end
		return murder_hrp_cache
	end

	local function flat_dist(a, b)
		return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
	end

	local function pick_coin(pos, list, mpos)
		if not (avoid_murder and mpos) then
			return nearest_coin(pos, list)
		end
		local safe, sd = nil, math.huge
		local far, fd = nil, -1
		for _, v in ipairs(list) do
			local md = flat_dist(v.Position, mpos)
			if md > fd then fd = md far = v end
			if md >= AVOID_DIST then
				local d = (v.Position - pos).Magnitude
				if d < sd then sd = d safe = v end
			end
		end
		if safe then return safe end
		if far and fd >= AVOID_DIST * 0.6 then return far end
		return nil
	end

	local function coin_ok_now(v, mpos)
		if not coin_available(v) then return false end
		if avoid_murder and mpos and flat_dist(v.Position, mpos) < AVOID_DIST * 0.6 then return false end
		return true
	end

	local function avoid_steer(cur, dest, mpos)
		if not (avoid_murder and mpos) then return dest end
		local dm = flat_dist(cur, mpos)
		if dm >= AVOID_DIST then return dest end
		local away = Vector3.new(cur.X - mpos.X, 0, cur.Z - mpos.Z)
		if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
		away = away.Unit
		local want = Vector3.new(dest.X - cur.X, 0, dest.Z - cur.Z)
		local mag = want.Magnitude
		if mag < 0.1 then return dest end
		local weight = 1 + (1 - dm / AVOID_DIST) * 2
		local blend = (want.Unit + away * weight)
		if blend.Magnitude < 0.1 then blend = away else blend = blend.Unit end
		local np = cur + blend * mag
		return Vector3.new(np.X, dest.Y, np.Z)
	end

	local function touch_targets(coin)
		local list = {}
		local seen = {}
		local function add(p)
			if p and not seen[p] and p:IsA("BasePart") and p:FindFirstChildOfClass("TouchTransmitter") then
				seen[p] = true
				list[#list + 1] = p
			end
		end
		add(coin)
		for _, v in ipairs(coin:GetChildren()) do add(v) end
		local par = coin.Parent
		if par then
			if par:IsA("BasePart") then add(par) end
			for _, v in ipairs(par:GetChildren()) do add(v) end
		end
		if #list == 0 then list[1] = coin end
		return list
	end

	local function fire_touch(coin)
		if type(firetouchinterest) ~= "function" then return end
		if not coin or not coin.Parent then return end
		local now = os.clock()
		if now - last_touch < 0.05 then return end
		last_touch = now
		local hrp = farm_hrp()
		if not hrp then return end
		for _, p in ipairs(touch_targets(coin)) do
			pcall(firetouchinterest, hrp, p, 0)
			pcall(firetouchinterest, hrp, p, 1)
		end
	end

	local function farm_move(hrp, dest, dt)
		local dir = dest - hrp.Position
		local dist = dir.Magnitude
		local np = dest
		if dist > 0.1 then
			np = hrp.Position + dir.Unit * math.min(farm_speed * dt, dist)
		end
		local cf = CFrame.new(np)
		if farm_mode == "Down" then
			cf = cf * CFrame.Angles(-math.pi * 0.5, 0, 0)
			was_down = true
		end
		pcall(function()
			hrp.CFrame = cf
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
	end

	local farm_conn = run.Stepped:Connect(function(_, dt)
		if not autofarm_on then return end
		if not can_farm() then
			farm_target = nil
			was_down = false
			farm_stage_unlock()
			set_farm_noclip(false)
			return
		end
		local hrp = farm_hrp()
		if not hrp then return end

		-- Stage in a fixed position until the round creates CoinVisuals. The old
		-- noclip/PlatformStand staging let gravity pull the character down between teleports.
		local stage_name, stage_pos = find_active_farm_map()
		local stage_coins = available_coins()
		if not farm_stage_ready then
			if #stage_coins == 0 then
				if stage_pos then
					stage_before_coins()
				else
					farm_stage_to_map(farm_unknown_stage_position)
				end
				return
			end
			if stage_pos then
				farm_stage_ready = true
				farm_stage_unlock()
				set_farm_noclip(false)
					hrp = farm_hrp()
				if not hrp then return end
			else
				local inferred_position = farm_unknown_map_position(stage_coins)
				if inferred_position then farm_stage_to_map(inferred_position) end
				farm_stage_ready = true
				farm_stage_unlock()
				set_farm_noclip(false)
					hrp = farm_hrp()
				if not hrp then return end
			end
		end

		local list = {}
		for _, v in ipairs(cs:GetTagged("CoinVisual")) do
			if v and v.Parent and v:IsA("BasePart") then
				if v:GetAttribute("Collected") then
					local id = v:GetAttribute("CoinID")
					if id and not collected_ids[id] then
						collected_ids[id] = true
						collected_count = collected_count + 1
					end
				elseif not v:GetAttribute("Delete") then
					list[#list + 1] = v
				end
			end
		end

		local function finish()
			-- Never trigger post-bag actions just because no coins are currently visible.
			-- The actual in-game bag UI must explicitly report full first.
			if not coin_bags_full() then
				farm_target = nil
				farm_release()
				return
			end
			farm_target = nil
			farm_release()
			if not coins_done then
				coins_done = true
				update_hold()
				if type(getgenv().AUTOFARM_BAG_CALLBACK) == "function" then
					task.spawn(function()
						local callbackOk, callbackErr = pcall(getgenv().AUTOFARM_BAG_CALLBACK)
						if not callbackOk then
							warn("[AutoFarm] Post-bag callback failed: " .. tostring(callbackErr))
						end
					end)
				end
				auto_reset_for_role()
			end
		end

		if saw_coins and coin_bags_full() then
			finish()
			return
		end

		if #list > 0 then
			saw_coins = true
			if coins_done then coins_done = false update_hold() end

			local mhrp = avoid_murder and murderer_hrp() or nil
			local mpos = mhrp and mhrp.Position or nil

			if not coin_ok_now(farm_target, mpos) then
				farm_target = pick_coin(hrp.Position, list, mpos)
			end

			if farm_target then
				set_farm_noclip(true)
				local cpos = farm_target.Position
				down_ref_y = cpos.Y
				local dest = cpos

				if farm_mode == "Down" then
					local xz = flat_dist(hrp.Position, cpos)
					local safe_to_rise = (not mpos) or flat_dist(hrp.Position, mpos) > RISE_SAFE_DIST
					if xz <= DOWN_RISE_XZ and safe_to_rise then
						dest = cpos
						fire_touch(farm_target)
					else
						dest = Vector3.new(cpos.X, cpos.Y - DOWN_DEPTH, cpos.Z)
					end
				elseif (cpos - hrp.Position).Magnitude <= 6 then
					fire_touch(farm_target)
				end

				dest = avoid_steer(hrp.Position, dest, mpos)
				farm_move(hrp, dest, dt)
			elseif mpos then
				set_farm_noclip(true)
				local away = Vector3.new(hrp.Position.X - mpos.X, 0, hrp.Position.Z - mpos.Z)
				if away.Magnitude < 0.1 then away = Vector3.new(1, 0, 0) end
				away = away.Unit
				local y = hrp.Position.Y
				if farm_mode == "Down" and down_ref_y then y = down_ref_y - DOWN_DEPTH end
				farm_move(hrp, hrp.Position + away * 40 + Vector3.new(0, y - hrp.Position.Y, 0), dt)
			end
		else
			farm_target = nil
			farm_release()
			if saw_coins and not coins_done and collected_count > 0 then
				finish()
			end
		end
	end)



