	local function step_push(dt)
		if dt <= 0 or dt > 0.5 then return end
		if EC.step_seen then
			EC.step = EC.step * 0.85 + dt * 0.15
		else
			EC.step = dt
			EC.step_seen = true
		end
	end

	local function sample_span()
		local span = math.max(EC.step, TR.gap)
		if span <= 0 then return 0 end
		return span
	end

	local HY = {
