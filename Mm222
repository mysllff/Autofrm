    local function server_hop_request(url)
        local request_fn = (syn and syn.request) or (http and http.request)
            or rawget(getgenv(), "http_request") or rawget(getgenv(), "request")
        if type(request_fn) == "function" then
            local ok, response = pcall(request_fn, { Url = url, Method = "GET" })
            if ok and type(response) == "table"
                and (tonumber(response.StatusCode) == 200 or response.StatusCode == nil)
                and type(response.Body) == "string" then
                return response.Body
            end
        end
        local ok, body = pcall(function() return HttpService:GetAsync(url) end)
        if ok and type(body) == "string" then return body end
        return nil
    end

    local function server_hop_find_target(require_more_players)
        local cursor = ""
        local candidates = {}
        local visited_in_scan = {}

        -- Follow the supplied Srvrhp.txt approach: fetch public instances, exclude full/current/recent servers,
        -- then choose a suitable server rather than falling back to generic matchmaking.
        for _ = 1, 10 do
            local url = string.format(
                "https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Desc&limit=100&excludeFullGames=true%s",
                game.PlaceId,
                cursor ~= "" and ("&cursor=" .. HttpService:UrlEncode(cursor)) or ""
            )
            local body = server_hop_request(url)
            if not body then break end
            local ok, data = pcall(function() return HttpService:JSONDecode(body) end)
            if not ok or type(data) ~= "table" or type(data.data) ~= "table" then break end

            for _, server in ipairs(data.data) do
                local id = type(server) == "table" and tostring(server.id or "") or ""
                local playing = type(server) == "table" and tonumber(server.playing) or nil
                local max_players = type(server) == "table" and tonumber(server.maxPlayers) or nil
                if id ~= "" and id ~= tostring(game.JobId or "") and not visited_in_scan[id]
                    and not server_was_recent(id) and playing and max_players and max_players > playing then
                    visited_in_scan[id] = true
                    -- Player-count mode means the destination must be strictly above the selected limit.
                    if not require_more_players or playing > server_hop_player_limit then
                        table.insert(candidates, {
                            id = id,
                            playing = playing,
                            ping = tonumber(server.ping) or math.huge,
                        })
                    end
                end
            end

            cursor = tostring(data.nextPageCursor or "")
            if cursor == "" then break end
        end

        table.sort(candidates, function(a, b)
            if a.ping ~= b.ping then return a.ping < b.ping end
            return a.playing > b.playing
        end)
        return candidates[1] and candidates[1].id or nil
    end
    -- Public raw GitHub source used by queue_on_teleport after server changes.
    local FARM_SCRIPT_URL = "https://raw.githubusercontent.com/mysllff/Autofrm/refs/heads/main/Mm222"

    local function queueScript(code, data)
        local queue_fn = (type(queue_on_teleport) == "function" and queue_on_teleport)
            or (type(queueonteleport) == "function" and queueonteleport)
            or (syn and type(syn.queue_on_teleport) == "function" and syn.queue_on_teleport)
            or (fluxus and type(fluxus.queue_on_teleport) == "function" and fluxus.queue_on_teleport)

        if type(queue_fn) ~= "function" then
            warn("[queue] executor does not support queue_on_teleport")
            return false
        end

        local chunks = {}
        if data then
            local ok_encode, encoded = pcall(function()
                return HttpService:JSONEncode(data)
            end)
            if not ok_encode then
                warn("[queue] failed to encode server-hop state")
                return false
            end
            chunks[#chunks + 1] = string.format(
                "getgenv().__QUEUE_DATA = %s;",
                string.format("%q", encoded)
            )
        end
        chunks[#chunks + 1] = code

        local ok_queue = pcall(queue_fn, table.concat(chunks, "\n"))
        if not ok_queue then
            warn("[queue] failed to queue teleport script")
            return false
        end
        return true
    end

    local function queue_server_hop_script()
        local state = {
            server_hop_kicked = server_hop_kicked,
            server_hop_stuck = server_hop_stuck,
            server_hop_players = server_hop_players,
            server_hop_player_limit = server_hop_player_limit,
            recent_servers = server_hop_recent,
        }

        local loader = string.format([[
            task.spawn(function()
                if not game:IsLoaded() then
                    game.Loaded:Wait()
                end

                local ok, source = pcall(function()
                    return game:HttpGet(%q)
                end)
                if not ok or type(source) ~= "string" or #source == 0 then
                    warn("[queue] failed to download AutoFarm from GitHub: " .. tostring(source))
                    return
                end

                local fn, compile_error = loadstring(source, "@AutoFarm_WindUI.lua")
                if not fn then
                    warn("[queue] failed to compile AutoFarm source: " .. tostring(compile_error))
                    return
                end

                local run_ok, run_error = pcall(fn)
                if not run_ok then
                    warn("[queue] AutoFarm failed after teleport: " .. tostring(run_error))
                end
            end)
        ]], FARM_SCRIPT_URL)

        return queueScript(loader, state)
    end

    -- Restore queued state early when the script starts in a new server.
    do
        local queued_state = getgenv().__QUEUE_DATA
        if type(queued_state) == "string" and queued_state ~= "" then
            local ok, data = pcall(function()
                return HttpService:JSONDecode(queued_state)
            end)
            if ok and type(data) == "table" then
                if type(data.server_hop_kicked) == "boolean" then server_hop_kicked = data.server_hop_kicked end
                if type(data.server_hop_stuck) == "boolean" then server_hop_stuck = data.server_hop_stuck end
                if type(data.server_hop_players) == "boolean" then server_hop_players = data.server_hop_players end
                if type(data.server_hop_player_limit) == "number" then
                    server_hop_player_limit = math.clamp(data.server_hop_player_limit, 1, 10)
                end
                if type(data.recent_servers) == "table" then
                    table.clear(server_hop_recent)
                    for _, server_id in ipairs(data.recent_servers) do
                        if type(server_id) == "string" and server_id ~= "" and #server_hop_recent < 25 then
                            server_hop_recent[#server_hop_recent + 1] = server_id
                        end
                    end
                    remember_server(tostring(game.JobId or ""))
                end
            end
            getgenv().__QUEUE_DATA = nil
        end
    end

    local function perform_server_hop(reason)
        local now = os.clock()
        if server_hop_busy or now < server_hop_next_attempt then return false end
        server_hop_busy = true
        server_hop_next_attempt = now + SERVER_HOP_COOLDOWN

        local require_more_players = reason == "players"
        local target = server_hop_find_target(require_more_players)
        if not target then
            warn("[server hop] no unvisited public server found; refusing generic teleport to avoid rejoining this server")
            server_hop_busy = false
            return false
        end

        -- Persist the current server in the visited list. The destination is recorded by
        -- the next script instance after the teleport succeeds, preventing a bounce-back loop.
        remember_server(tostring(game.JobId or ""))
        local queued = queue_server_hop_script()
        if not queued then
            warn("[server hop] rejoin script could not be queued; teleporting without automatic restart")
        end
        local ok, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(game.PlaceId, target, lp)
        end)
        if ok then return true end

        server_hop_busy = false
        warn("[server hop] teleport failed: " .. tostring(err))
        return false
    end
    local function reset_server_hop_coin_timer()
        server_hop_last_coin = os.clock()
    end

    -- A coin appearing anywhere in the round means the game is no longer considered stuck.
    local server_coin_added_conn = CollectionService:GetInstanceAddedSignal("CoinVisual"):Connect(function()
        reset_server_hop_coin_timer()
    end)

    local server_desc_coin_conn = ws.DescendantAdded:Connect(function(obj)
        if obj:IsA("BasePart") and (obj.Name == "Coin" or obj.Name == "CoinVisual") then
            reset_server_hop_coin_timer()
        end
    end)

    -- Kicks/disconnect messages are exposed through GuiService before the client leaves.
    local server_kick_conn = GuiService.ErrorMessageChanged:Connect(function(message)
        if not server_hop_kicked or server_hop_busy then return end
        local text_message = string.lower(tostring(message or ""))
        if text_message:find("kick", 1, true)
            or text_message:find("disconnect", 1, true)
            or text_message:find("removed from the game", 1, true) then
            task.defer(function()
                perform_server_hop("kicked")
            end)
        end
    end)

    local teleport_failed_conn = TeleportService.TeleportInitFailed:Connect(function()
        server_hop_busy = false
        server_hop_next_attempt = math.max(server_hop_next_attempt, os.clock() + 8)
    end)

    local SettingsSection = SettingsTab:Section({
        Title = "Server Hop",
        Box = true,
        Opened = true,
    })

    SettingsSection:Toggle({
        Title = "Server Hop if Kicked",
        Desc = "Attempts to join another public server when a kick/disconnect message is detected.",
        Flag = "Server Hop if Kicked",
        Value = server_hop_kicked,
        Callback = function(v)
            server_hop_kicked = v
            farm_config_set("server_hop_kicked", v)
        end,
    })

    SettingsSection:Toggle({
        Title = "Server Hop if Game Stuck",
        Desc = "Hops after 6 minutes without seeing a coin.",
        Flag = "Server Hop if Game Stuck",
        Value = server_hop_stuck,
        Callback = function(v)
            server_hop_stuck = v
            server_hop_last_coin = os.clock()
            farm_config_set("server_hop_stuck", v)
        end,
    })

    SettingsSection:Toggle({
        Title = "Server Hop if Player Count is Low",
        Desc = "Hops when the server has the selected number of players or fewer.",
        Flag = "Server Hop if Players",
        Value = server_hop_players,
        Callback = function(v)
            server_hop_players = v
            farm_config_set("server_hop_players", v)
        end,
    })

    SettingsSection:Slider({
        Title = "Player Count Limit",
        Desc = "Server hop when the current player count is at or below this number.",
        Flag = "Server Hop Player Limit",
        Step = 1,
        Value = {
            Min = 1,
            Max = 10,
            Default = math.clamp(server_hop_player_limit, 1, 10),
        },
        Callback = function(v)
            server_hop_player_limit = math.clamp(tonumber(v) or 3, 1, 10)
            farm_config.server_hop_player_limit = server_hop_player_limit
            -- Avoid writing the config file for every slider drag event.
            local save_token = (getgenv().__AUTOFARM_LIMIT_SAVE_TOKEN or 0) + 1
            getgenv().__AUTOFARM_LIMIT_SAVE_TOKEN = save_token
            task.delay(0.5, function()
                if getgenv().__AUTOFARM_LIMIT_SAVE_TOKEN == save_token then farm_config_save() end
            end)
        end,
    })

    SettingsSection:Button({
        Title = "Server Hop",
        Desc = "Manually joins another public server for testing or emergency use.",
        Callback = function()
            task.spawn(perform_server_hop, "manual")
        end,
    })

    local server_hop_monitor_pending = false
    local settings_monitor_conn = RunService.Heartbeat:Connect(function()
        if server_hop_busy or server_hop_monitor_pending or os.clock() < server_hop_next_attempt then return end

        local reason = nil
        if server_hop_players and #Players:GetPlayers() <= server_hop_player_limit then
            reason = "players"
        elseif server_hop_stuck and os.clock() - server_hop_last_coin >= SERVER_STUCK_TIMEOUT then
            reason = "stuck"
        end
        if reason then
            server_hop_monitor_pending = true
            task.spawn(function()
                local ok, err = pcall(perform_server_hop, reason)
                if not ok then warn("[server hop] attempt failed: " .. tostring(err)) end
                server_hop_monitor_pending = false
            end)
        end
    end)

    local fling_step = RunService.Stepped:Connect(function()
        if not anti_fling then return end
        if not fling_attached then pcall(fling_attach) end
        pcall(fling_sweep)
        pcall(fling_guard, true)
    end)
    local fling_heartbeat = RunService.Heartbeat:Connect(function()
        if anti_fling then pcall(fling_guard, false) end
    end)

    getgenv().AUTOFARM_EXTRAS_UNLOAD = function()
        pcall(function() getgenv().AUTOSHOOT_STOP() end)
        kill_all_on=false
        autoshoot_on=false
        fling_murder_sheriff_on=false
        fling_murder_innocent_on=false
        role_fling_role=nil
        getgenv().AUTOFARM_BAG_FLING_ACTIVE=false
        if role_fling_thread then pcall(task.cancel, role_fling_thread); role_fling_thread=nil end
        anti_afk=false
        anti_fling=false
        anti_trap=false
        set_void(false)
        disable_render=false
        pcall(apply_render)
        trap_detach()
        fling_restore()
        reset_fps()
        if idle_conn then pcall(function() idle_conn:Disconnect() end); idle_conn=nil end
        if fling_step then pcall(function() fling_step:Disconnect() end); fling_step=nil end
        if fling_heartbeat then pcall(function() fling_heartbeat:Disconnect() end); fling_heartbeat=nil end
        if settings_monitor_conn then pcall(function() settings_monitor_conn:Disconnect() end); settings_monitor_conn=nil end
        if server_coin_added_conn then pcall(function() server_coin_added_conn:Disconnect() end); server_coin_added_conn=nil end
        if server_desc_coin_conn then pcall(function() server_desc_coin_conn:Disconnect() end); server_desc_coin_conn=nil end
        if server_kick_conn then pcall(function() server_kick_conn:Disconnect() end); server_kick_conn=nil end
        if teleport_failed_conn then pcall(function() teleport_failed_conn:Disconnect() end); teleport_failed_conn=nil end
        getgenv().AUTOFARM_BAG_CALLBACK=nil
    end
end
