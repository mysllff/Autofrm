-- Prevent duplicate queued executions from stacking UI and worker loops in the same server.
do
    local env = (type(getgenv) == "function" and getgenv()) or _G
    local jobId = tostring(game.JobId or "")
    if jobId ~= "" and env.__AUTOFARM_RUNNING_JOB == jobId then
        return
    end
    env.__AUTOFARM_RUNNING_JOB = jobId
end

-- Restore the last device selection after a rejoin/server hop.
-- This follows the game's DeviceSelect GUI and ChangeLastDevice remote.
task.spawn(function()
    local Players = game:GetService("Players")
    local ReplicatedStorage = game:GetService("ReplicatedStorage")
    local player = Players.LocalPlayer
    local playerGui = player:WaitForChild("PlayerGui")
    local MAX_ATTEMPTS = 45
    local attempts = 0
    local completed = false

    local function tapUI(button)
        if not button then return false end
        if type(getconnections) ~= "function" then return false end

        local fired = false
        for _, eventName in ipairs({"MouseButton1Click", "MouseButton1Down", "Activated"}) do
            local ok, signal = pcall(function() return button[eventName] end)
            if ok and signal then
                local okConnections, connections = pcall(getconnections, signal)
                if okConnections and type(connections) == "table" then
                    for _, connection in ipairs(connections) do
                        if type(connection.Function) == "function" then
                            local callOk = pcall(connection.Function)
                            fired = fired or callOk
                        end
                    end
                end
            end
        end
        return fired
    end

    local function getDeviceButton()
        local selection = playerGui:FindFirstChild("DeviceSelect")
        local container = selection and selection:FindFirstChild("Container")
        local tablet = container and container:FindFirstChild("Tablet")
        local button = tablet and tablet:FindFirstChild("Button")
        return button
    end

    local function getChangeDeviceRemote()
        local remotes = ReplicatedStorage:FindFirstChild("Remotes")
        local extras = remotes and remotes:FindFirstChild("Extras")
        local remote = extras and extras:FindFirstChild("ChangeLastDevice")
        if remote and remote:IsA("RemoteEvent") then return remote end
        return nil
    end

    while attempts < MAX_ATTEMPTS and not completed do
        attempts += 1
        pcall(function()
            local button = getDeviceButton()
            if button then tapUI(button) end

            local remote = getChangeDeviceRemote()
            if remote then
                remote:FireServer("Tablet")
            end

            -- Some versions of the game require pressing Play after choosing a device.
            local join = playerGui:FindFirstChild("Join")
            local friends = join and join:FindFirstChild("Friends")
            local playButton = friends and friends:FindFirstChild("Play")
            if playButton then tapUI(playButton) end
        end)

        if playerGui:FindFirstChild("MainGUI") then
            completed = true
            break
        end
        task.wait(1)
    end

    if completed then
        print(string.format("[device] selection completed after %d attempts", attempts))
    else
        warn("[device] selection did not complete; MainGUI was not found")
    end
end)

