local function farm_config_load()
    if type(isfile) ~= "function" or type(readfile) ~= "function" then return end
    local ok, exists = pcall(isfile, FARM_CONFIG_FILE)
    if not ok or not exists then return end
    local ok_read, raw = pcall(readfile, FARM_CONFIG_FILE)
    if not ok_read or type(raw) ~= "string" or raw == "" then return end
    local ok_decode, data = pcall(function() return HttpService:JSONDecode(raw) end)
    if ok_decode and type(data) == "table" then
        for key, default in pairs(farm_config) do
            if type(default) == "boolean" and type(data[key]) == "boolean" then
                farm_config[key] = data[key]
            elseif type(default) == "number" and type(data[key]) == "number" then
                farm_config[key] = data[key]
            elseif type(default) == "string" and type(data[key]) == "string" then
                farm_config[key] = data[key]
            end
        end
    end
end

local function farm_config_save()
    if type(writefile) ~= "function" then return end
    pcall(function()
        writefile(FARM_CONFIG_FILE, HttpService:JSONEncode(farm_config))
    end)
end

getgenv().AUTOFARM_BAG_FLING_ACTIVE = false

local function farm_config_set(key, value)
    if farm_config[key] == value then return end
    farm_config[key] = value
    farm_config_save()
end

farm_config_load()
if type(isfile) == "function" and type(readfile) == "function" then
    local ok_exists, exists = pcall(isfile, FARM_CONFIG_FILE)
    if ok_exists and not exists then
        farm_config_save()
    end
end

