            if hum.JumpPower > TRAP_LOCK then trap_jump_cache = hum.JumpPower end
        end
        trap_kill_gui()
        if trap_busy then return end
        trap_busy = true
        task.spawn(function()
            while anti_trap and os.clock() < trap_window do
                trap_unlock(trap_hum())
                trap_kill_gui()
                RunService.Heartbeat:Wait()
            end
