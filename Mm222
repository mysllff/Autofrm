    -- This is deliberately defined in this do-block: the farm's original
    -- coin_bags_full() is local to the farm do-block and cannot be called here.
    -- Match the same visible MainGUI/Game/CoinBags/Container/Full check.
    local function bag_is_full()
        local pg = lp:FindFirstChild("PlayerGui")
        local main = pg and pg:FindFirstChild("MainGUI")
        local gameFrame = main and main:FindFirstChild("Game")
        local bags = gameFrame and gameFrame:FindFirstChild("CoinBags")
        local container = bags and bags:FindFirstChild("Container")
        if not container then return false end

        local foundVisibleBag = false
        for _, item in ipairs(container:GetChildren()) do
            if item:IsA("Frame") and item.Visible then
                foundVisibleBag = true
                local full = item:FindFirstChild("Full")
                if not (full and full.Visible) then return false end
            end
        end
        return foundVisibleBag
    end
    local ws = workspace

    local kill_all_on = farm_config.kill_all
    local autoshoot_on = farm_config.autoshoot
    local anti_afk = farm_config.anti_afk
    local anti_fling = farm_config.anti_fling
    local anti_void = farm_config.anti_void
    local anti_trap = farm_config.anti_trap
    local disable_render = farm_config.disable_render
    local fps_cap = tonumber(farm_config.fps_cap) or 60

    -- Kill All: copied from the source kill-aura implementation, but triggered after a full bag.
    local round_mod = nil
    local function get_round()
        if round_mod then return round_mod end
        local ok, m = pcall(function()
            return require(ReplicatedStorage:WaitForChild("Modules"):WaitForChild("CurrentRoundClient"))
        end)
        if ok and type(m) == "table" then round_mod = m end
        return round_mod
    end

    local function local_has_gun()
        local character = lp.Character
        local backpack = lp:FindFirstChildOfClass("Backpack")
        return (character and character:FindFirstChild("Gun") ~= nil)
            or (backpack and backpack:FindFirstChild("Gun") ~= nil) or false
    end

    local function get_player_data()
        local m = get_round()
        local data = m and m.PlayerData
        -- CurrentRoundClient can be nil/stale at the exact moment the bag fills.
        -- Fall back to the game's live role RemoteFunction before giving up.
        local me = type(data) == "table" and data[lp.Name]
        if not me or not me.Role then
            local remote = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
            if remote and remote:IsA("RemoteFunction") then
                local ok, liveData = pcall(function() return remote:InvokeServer() end)
                if ok and type(liveData) == "table" then
                    data = liveData
                    me = data[lp.Name]
                end
            end
        end
        return data, me
    end

    local function local_role()
        local _, me = get_player_data()
        local role = me and me.Role
        -- A Gun in Character or Backpack overrides stale/missing role data.
        if local_has_gun() then role = "Sheriff" end
        return role, me
    end

    local function ensure_knife_equipped()
        local char = lp.Character
        if char then
            local k = char:FindFirstChild("Knife")
            if k then return k end
        end
