    local role_fling_thread
    local role_fling_last_error_at = 0

    local function role_fling_step()
        if role_fling_thread then return end
        role_fling_thread = task.spawn(function()
            -- Keep cleanup reliable if an unexpected runtime error occurs in this worker.
            local ok, err = xpcall(function()
                -- This loop survives local death/respawn and ends only when the target Murderer dies,
                -- the corresponding toggle is disabled, or the bag action is explicitly cancelled.
                while getgenv().AUTOFARM_BAG_FLING_ACTIVE do
                    -- Never run the fling unless the visible bag UI confirms it is full.
                    if not bag_is_full() then
                        task.wait(0.25)
                        continue
                    end

                    -- Use this block's role-data accessor, which falls back to GetPlayerData.
                    local data, me = get_player_data()
                    local role = me and me.Role
                    if local_has_gun() then role = "Sheriff" end
                    -- Round data can briefly disappear during respawn/role refresh; retry
                    -- using live server role data instead of silently ending the fling action.
                    if not role then
                        task.wait(0.5)
                        continue
                    end
                    local enabled = (role == "Sheriff" and fling_murder_sheriff_on)
                        or (role == "Innocent" and fling_murder_innocent_on)
                    if not enabled then break end

                    local target, target_info
                    -- Match used.lua's findMurderer(): query the game's GetPlayerData
                    -- RemoteFunction first, then fall back to CurrentRoundClient.PlayerData.
                    local getPlayerData = ReplicatedStorage:FindFirstChild("GetPlayerData", true)
                    if getPlayerData and getPlayerData:IsA("RemoteFunction") then
                        local okData, serverData = pcall(function()
                            return getPlayerData:InvokeServer()
                        end)
                        if okData and type(serverData) == "table" then
                            for name, info in pairs(serverData) do
                                if type(info) == "table" and info.Role == "Murderer"
                                    and not info.Dead and not info.Killed and name ~= lp.Name then
                                    target_info = info
                                    target = Players:FindFirstChild(name)
                                    if target then break end
                                end
                            end
                        end
                    end
                    if not target and type(data) == "table" then
                        for name, info in pairs(data) do
                            if type(info) == "table" and info.Role == "Murderer"
                                and not info.Dead and not info.Killed and name ~= lp.Name then
                                target_info = info
                                target = Players:FindFirstChild(name)
                                if target then break end
                            end
                        end
                    end

                    -- Do not fling during the lobby/device-selection phase. Require valid role
                    -- data for both players and a live Murderer character before engaging.
                    local valid_local_role = role == "Sheriff" or role == "Innocent"
                    if not valid_local_role or not target or not target_info
                        or target_info.Role ~= "Murderer" then
                        task.wait(0.25)
                        continue
                    end

                    if target_info.Dead == true or target_info.Killed == true then
                        break
                    end

                    local targetChar = target.Character
                    local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")
                    local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
                    if not targetHum or targetHum.Health <= 0 or not targetRoot then
                        task.wait(0.25)
                        continue
                    end

                    -- Retry after local death/respawn or a temporary busy state.
                    if type(getgenv().AUTOFARM_ROLE_FLING) == "function" then
                        local call_ok, result = pcall(getgenv().AUTOFARM_ROLE_FLING, target)
                        if not call_ok then
                            local now = os.clock()
                            if now - role_fling_last_error_at >= 5 then
                                warn("[AutoFarm] role fling error: " .. tostring(result))
                                role_fling_last_error_at = now
                            end
                        end
                    end
                    task.wait(0.05)
                end
            end, debug.traceback)

            if not ok then
                local now = os.clock()
                if now - role_fling_last_error_at >= 5 then
                    warn("[AutoFarm] role fling worker stopped unexpectedly: " .. tostring(err))
                    role_fling_last_error_at = now
                end
            end

            role_fling_thread = nil
            if not ok and getgenv().AUTOFARM_BAG_FLING_ACTIVE and bag_is_full() then
                -- Retry only after an unexpected error; normal exits (dead target or disabled
                -- role toggle) must stop instead of creating a restart loop.
                task.delay(0.5, role_fling_step)
            else
                getgenv().AUTOFARM_BAG_FLING_ACTIVE = false
            end
        end)
    end

