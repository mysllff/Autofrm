    -- Anti-Fling: source registration/sweep logic plus a safe-position guard.
    local fling_cache = {}
    local fling_reg = {}
    local fling_conns = {}
    local fling_attached = false
    local fling_safe_cf = nil
    local fling_hold_until = 0
    local fling_active_since = 0
    local FLING_MAX_VEL, FLING_MAX_ANG = 700, 90
    local FLING_SNAP_DIST, FLING_HOLD, FLING_SAFE_VEL = 60, 0.25, 250

    local function fling_busy()
        if getgenv().AUTOFARM_BAG_FLING_ACTIVE then return true end
        if os.clock() < (getgenv().VELOCITY_DESYNC_UNTIL or 0) then return true end
        if (getgenv().FLING_ACTIVE or 0) > 0 then
            local now = os.clock()
            if fling_active_since == 0 then fling_active_since = now end
            if now - fling_active_since < 20 then return true end
            getgenv().FLING_ACTIVE = 0
            fling_active_since = 0
            return false
        end
        fling_active_since = 0
        return false
    end

    local function fling_kill_part(part)
        if fling_cache[part] == nil then fling_cache[part] = part.CanCollide end
        if part.CanCollide then part.CanCollide = false end
    end

    local function fling_unregister(model)
        local entry = fling_reg[model]
        if not entry then return end
        fling_reg[model] = nil
        for _, conn in ipairs(entry.conns) do pcall(function() conn:Disconnect() end) end
        for part in pairs(entry.parts) do
            local old = fling_cache[part]
            fling_cache[part] = nil
            if old ~= nil and part.Parent then pcall(function() part.CanCollide = old end) end
        end
        table.clear(entry.parts)
    end

    local function fling_register(model)
        if not anti_fling or not model or model == lp.Character or fling_reg[model] then return end
        local entry = {parts = {}, conns = {}}
        fling_reg[model] = entry
        local function add(descendant)
            if descendant:IsA("BasePart") and not entry.parts[descendant] then
                entry.parts[descendant] = true
                if anti_fling then pcall(fling_kill_part, descendant) end
            end
        end
        for _, descendant in ipairs(model:GetDescendants()) do pcall(add, descendant) end
        entry.conns[#entry.conns + 1] = model.DescendantAdded:Connect(function(descendant)
            if anti_fling then pcall(add, descendant) end
        end)
        entry.conns[#entry.conns + 1] = model.DescendantRemoving:Connect(function(descendant)
            entry.parts[descendant] = nil
            fling_cache[descendant] = nil
        end)
        entry.conns[#entry.conns + 1] = model.AncestryChanged:Connect(function(_, parent)
            if not parent then fling_unregister(model) end
        end)
    end

    local function fling_is_body(model)
        return model ~= lp.Character and model:IsA("Model")
            and model:FindFirstChildOfClass("Humanoid") ~= nil
    end

    local function fling_scan()
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Character then fling_register(player.Character) end
        end
        for _, model in ipairs(ws:GetChildren()) do
            if fling_is_body(model) then fling_register(model) end
        end
    end

    local function fling_sweep()
        for model, entry in pairs(fling_reg) do
            if not model.Parent or model == lp.Character then
                fling_unregister(model)
            else
                for part in pairs(entry.parts) do
                    if part.Parent then
                        if part.CanCollide then
                            if fling_cache[part] == nil then fling_cache[part] = true end
                            part.CanCollide = false
                        end
                    else
                        entry.parts[part] = nil
                        fling_cache[part] = nil
                    end
                end
            end
        end
    end

    local function fling_guard(full)
        local character = lp.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        if not root or not root.Parent then
            fling_safe_cf = nil
            return
        end
        -- Do not cancel our own bag-triggered fling or another active velocity action.
        if fling_busy() then
            fling_safe_cf = nil
            return
        end
        local linear = root.AssemblyLinearVelocity
        local angular = root.AssemblyAngularVelocity
        local spike = linear.Magnitude > FLING_MAX_VEL or angular.Magnitude > FLING_MAX_ANG
        local now = os.clock()
        if spike then fling_hold_until = now + FLING_HOLD end
        if spike or now < fling_hold_until then
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
            if full and fling_safe_cf and (root.Position - fling_safe_cf.Position).Magnitude > FLING_SNAP_DIST then
                root.CFrame = fling_safe_cf
            end
        elseif full and linear.Magnitude < FLING_SAFE_VEL then
            fling_safe_cf = root.CFrame
        end
    end

    local function fling_detach()
        fling_attached = false
        for _, conn in ipairs(fling_conns) do pcall(function() conn:Disconnect() end) end
        table.clear(fling_conns)
    end

    local function fling_attach()
        if fling_attached then return end
        fling_attached = true
        local function push(conn) fling_conns[#fling_conns + 1] = conn end
        local function watch(player)
            if player == lp then return end
            push(player.CharacterAdded:Connect(function(character)
                if anti_fling then fling_register(character) end
            end))
            push(player.CharacterRemoving:Connect(function(character)
                fling_unregister(character)
            end))
        end
        for _, player in ipairs(Players:GetPlayers()) do watch(player) end
        push(Players.PlayerAdded:Connect(function(player)
            watch(player)
            if anti_fling and player.Character then fling_register(player.Character) end
        end))
        push(Players.PlayerRemoving:Connect(function(player)
            if player.Character then fling_unregister(player.Character) end
        end))
        push(ws.ChildAdded:Connect(function(model)
            if not anti_fling then return end
            task.defer(function()
                if anti_fling and model.Parent == ws and fling_is_body(model) then fling_register(model) end
            end)
        end))
        push(lp.CharacterAdded:Connect(function()
            fling_safe_cf = nil
            fling_hold_until = 0
            if anti_fling then task.defer(fling_scan) end
        end))
        fling_scan()
    end

    local function fling_restore()
        fling_detach()
        for model in pairs(fling_reg) do fling_unregister(model) end
        table.clear(fling_reg)
        for part, old in pairs(fling_cache) do
            if part and part.Parent then pcall(function() part.CanCollide = old end) end
        end
        table.clear(fling_cache)
        fling_safe_cf = nil
        fling_hold_until = 0
    end

